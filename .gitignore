# Virtual environments
venv/
myenv/

# Python cache
__pycache__/
*.pyc
*.pyo

# macOS
.DS_Store

# Logs (symlink, not stored)
logs/

# IDE
.claude/settings.local.json

# Runtime data (generated at runtime)
config/ohme_status.json
config/solax_mode_change_log.json
data/battery_mode_daemon_log.json
config/solar_forecast.json
config/resideo_token_state.json
config/claude_usage.json
config/mg_saic_status.json
config/battery_evening_prediction.json
config/hotwater_automation_state.json
data/solar_forecast_model.joblib

# Historical zip archives (not tracked in git)
*.zip

# Real credentials (ohme_ev, melcloud, ...) - merged onto config.yaml at load time
# by src/config_manager/config_manager.py. See secrets.yaml.example for the format.
# Copy this file to another machine (e.g. the Pi) manually - it never travels via git
# in plaintext. An encrypted backup (secrets.yaml.enc) IS deliberately tracked - see
# scripts/encrypt_secrets.sh and scripts/decrypt_secrets.sh.
secrets.yaml
# ...and any stray plaintext copies. The encrypt/decrypt scripts work in
# $TMPDIR now, but a backup taken by hand before editing credentials (or a
# leftover from an older version of those scripts) would otherwise be
# untracked-but-committable, since only the exact name above is ignored.
# secrets.yaml.enc is the deliberate exception and stays tracked.
secrets.yaml.tmp
secrets.yaml.bak*
secrets.yaml.enc.tmp

# Lock sidecars for locked_json_update() (src/utils/state_store.py)
*.json.lock

# Coverage output (pytest-cov, see requirements-dev.txt)
.coverage
htmlcov/
