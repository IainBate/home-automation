[Unit]
Description=Home Automation Hot Water System
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/home_automation
ExecStart=/home/pi/home_automation/venv/bin/python /home/pi/home_automation/scripts/hotwater_mode_daemon.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
