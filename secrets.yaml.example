# Template for secrets.yaml - copy this file to secrets.yaml and fill in real values.
#
#   cp secrets.yaml.example secrets.yaml
#
# secrets.yaml is in .gitignore and is never committed - it's merged onto
# config.yaml at load time (src/config_manager/config_manager.py), so config.yaml
# itself can stay tracked in git with only placeholder values. See config.yaml's
# ohme_ev and melcloud sections for what each field is used for.
#
# To run on another machine (e.g. the Pi), copy secrets.yaml there directly
# (scp/rsync) - it does not travel via git.

ohme_ev:
  username: "your-ohme-email@example.com"
  password: "your-ohme-password"

melcloud:
  email: "your-melcloud-email@example.com"
  password: "your-melcloud-password"

resideo:
  # Your normal Resideo/Honeywell Home app login - via evohome-async, no
  # developer portal registration needed.
  username: "your-resideo-email@example.com"
  password: "your-resideo-password"

claude_usage:
  # From scripts/claude_usage_token_extract.py (run on whichever machine has
  # `claude` logged in). Expires after ~8 hours - re-extract and re-paste
  # whenever the dashboard shows "token expired".
  access_token: "your-claude-code-access-token"

mg_saic:
  username: "your-mg-ismart-email@example.com"
  password: "your-mg-ismart-password"

# No email: section here - scripts/weekly_health_check.py sends via the
# `msmtp` command-line tool (src/utils/emailer.py), which owns its own
# credentials in ~/.msmtprc, not in this file. See config.yaml's email:
# comments.
